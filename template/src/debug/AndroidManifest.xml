<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only, so never in the release APK Shrimpl bundles: a document provider the emulator
     tests use as a folder the user "picked" (docs/TESTING.md). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <provider
            android:name="com.valghora.shrimpl.webapp.TestTreeProvider"
            android:authorities="${applicationId}.testtree"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
    </application>
</manifest>
