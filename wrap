#!/usr/bin/env bash
# Turns a website into an Android app.
#
#   ./wrap https://example.com            discover the site, build, verify; APKs land in sites/<id>/apks/<version>/
#   ./wrap https://example.com --enrich   also let Claude review the draft (needs ANTHROPIC_API_KEY)
#   ./wrap --site discord                 rebuild a site that already has sites/<id>/site.toml
#   ./wrap --list                         list configured sites
#
# Options:
#   --id ID      site id for a new site (default: derived from the app name)
#   --force      overwrite an existing sites/<id>/ when discovering
#   --quick      build APKs only; skip tests, lint and the other verification checks
#   --preview    also render dist/<id>-icons.png (needs node + playwright)
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")"

usage() { sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

url="" site="" id="" force=() enrich=0 quick=0 preview=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage ;;
    --list) python3 scripts/site_config.py list; exit 0 ;;
    --site) site="${2:?--site needs an id}"; shift ;;
    --id) id="${2:?--id needs a value}"; shift ;;
    --force) force=(--force) ;;
    --enrich) enrich=1 ;;
    --quick) quick=1 ;;
    --preview) preview=1 ;;
    -*) echo "unknown option: $1" >&2; usage 2 ;;
    *) [[ -z "$url" ]] || { echo "only one URL at a time" >&2; exit 2; }; url="$1" ;;
  esac
  shift
done
if [[ -n "$url" && -n "$site" ]] || [[ -z "$url" && -z "$site" ]]; then
  echo "give either a URL or --site ID" >&2
  usage 2
fi

step() { printf '\n\033[1m==> %s\033[0m\n' "$*"; }

if [[ -n "$url" ]]; then
  step "Discovering $url"
  args=("$url" "${force[@]}")
  [[ -n "$id" ]] && args+=(--id "$id")
  site="$(python3 scripts/discover_site.py "${args[@]}" | tail -1)"
fi

if [[ $enrich == 1 ]]; then
  step "Reviewing sites/$site/site.toml with Claude"
  python3 scripts/enrich_site.py --site "$site"
fi

step "Validating sites/$site"
python3 scripts/site_config.py validate --site "$site"

step "Preparing the Android SDK"
scripts/setup_android_sdk.sh >/dev/null

if [[ $quick == 1 ]]; then
  step "Building $site (quick)"
  if command -v sha1sum >/dev/null; then hash() { sha1sum; }; else hash() { shasum -a 1; }; fi
  ./gradlew --project-cache-dir="$HOME/.cache/projects/$(basename "$PWD")-$(pwd -P | hash | cut -c1-8)/gradle" \
    "-Psite=$site" --console=plain -q assembleDebug assembleRelease
  props="$(python3 scripts/site_config.py properties --site "$site")"
  prop() { sed -n "s/^$1=//p" <<<"$props"; }
  mkdir -p "$(prop apkDir)"
  rm -f "$(prop apkDir)"/*.apk
  cp app/build/outputs/apk/debug/app-debug.apk "$(prop apkDir)/$(prop debugApkName)"
  cp "$(prop releaseApkPath)" "$(prop apkDir)/$(prop releaseApkName)"
  python3 scripts/site_config.py prune-apks --site "$site"
else
  step "Building and verifying $site"
  SITE="$site" scripts/ci_verify.sh
fi

if [[ $preview == 1 ]]; then
  step "Rendering icon preview"
  res="$(dirname "$(dirname "$(find app/build/generated -path '*ebug*' -path '*mipmap-anydpi*' -name ic_launcher.xml | head -1)")")"
  python3 scripts/preview_icons.py "$res" --out "dist/$site-icons.svg" --png "dist/$site-icons.png"
fi

step "Done"
echo "site=$site"
apk_dir="$(python3 scripts/site_config.py properties --site "$site" | sed -n 's/^apkDir=//p')"
ls -1 "$apk_dir"/*.apk 2>/dev/null
[[ $preview == 1 ]] && echo "dist/$site-icons.png"
echo "Install with: adb install -r $apk_dir/<file>.apk"
