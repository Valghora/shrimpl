{
  "schemaVersion": 1,
  "name": "Example",
  "appId": "example",
  "startUrl": "https://example.com/app",
  "internalDomains": [
    "example.com",
    "exampleapp.com",
    "example.gg",
    "example.net",
    "exampleapp.net"
  ],
  "oauthDomains": [
    "accounts.google.com",
    "appleid.apple.com",
    "github.com",
    "login.microsoftonline.com",
    "login.live.com"
  ],
  "userAgentMode": "auto",
  "userAgentOverride": "",
  "uaStoreRedirectFallback": true,
  "uaUserToggle": true,
  "iconBackground": "#3367D6",
  "iconForeground": "#FFFFFF",
  "headerColor": "#1E1F22",
  "allowMicrophone": true,
  "allowCamera": true,
  "allowNotifications": true,
  "allowProtectedMedia": false,
  "enableMultiWindow": true,
  "keepAliveWhenHidden": true,
  "pauseOnPowerSave": false,
  "nativeContextMenu": true,
  "defaultWindowDp": {
    "width": 1280,
    "height": 800
  },
  "minWindowDp": {
    "width": 400,
    "height": 500
  },
  "appShortcuts": [
    {
      "label": "Search",
      "key": "KEYCODE_K",
      "modifiers": [
        "CTRL"
      ]
    },
    {
      "label": "Toggle Mute",
      "key": "KEYCODE_M",
      "modifiers": [
        "CTRL",
        "SHIFT"
      ]
    },
    {
      "label": "Toggle Sound",
      "key": "KEYCODE_D",
      "modifiers": [
        "CTRL",
        "SHIFT"
      ]
    }
  ]
}
