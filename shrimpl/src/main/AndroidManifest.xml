<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Site discovery downloads pages, manifests, scripts and icons (docs/SHRIMPL_SPEC.md R9). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- R3.2: tells "no internet connection" apart from a site that can't be reached. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The system installer path (R6.1). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Shevery's API (R6.1). -->
    <uses-permission android:name="com.hamondev.shevery.permission.PRIVILEGED_API" />

    <queries>
        <!-- Chrome, which the Google sign-in notice names and opens when it is installed (R3.3). -->
        <package android:name="com.android.chrome" />
        <!-- Icon packs that hand back one icon for a custom app icon (R10.2). -->
        <intent>
            <action android:name="org.adw.launcher.icons.ACTION_PICK_ICON" />
        </intent>
        <!-- The web apps Shrimpl built: their install state, icon and launcher entry (R2.2). -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- The Shevery manager. -->
        <package android:name="com.hamondev.shevery" />
    </queries>

    <application
        android:name=".ShrimplApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.Shrimpl">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Install and uninstall results from PackageInstaller sessions. -->
        <receiver
            android:name=".install.InstallStatusReceiver"
            android:exported="false" />

        <!-- Shevery hands its binder to Shrimpl through this provider (R6.1). -->
        <provider
            android:name="com.hamondev.shevery.api.SheveryProvider"
            android:authorities="${applicationId}.shevery"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false" />
    </application>

</manifest>
